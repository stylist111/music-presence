{
  "manifest_version": 3,
  "name": "Music Presence",
  "version": "0.1.0",
  "description": "Показывает в Discord, что ты слушаешь в браузере.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://soundcloud.com/*", "https://www.youtube.com/*", "https://music.youtube.com/*",
        "https://music.yandex.ru/*", "https://open.spotify.com/*", "https://vk.com/*", "https://vk.ru/*",
        "https://zvuk.com/*", "https://*.bandcamp.com/*", "https://www.deezer.com/*",
        "https://music.apple.com/*", "https://listen.tidal.com/*"
      ],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://soundcloud.com/*", "https://www.youtube.com/*", "https://music.youtube.com/*",
        "https://music.yandex.ru/*", "https://open.spotify.com/*", "https://vk.com/*", "https://vk.ru/*",
        "https://zvuk.com/*", "https://*.bandcamp.com/*", "https://www.deezer.com/*",
        "https://music.apple.com/*", "https://listen.tidal.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
